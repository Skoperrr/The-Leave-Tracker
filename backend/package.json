{
  "name": "leave-tracker-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "node scripts/clean-build.mjs && npm run db:generate && tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx --env-file=.env src/scripts/check-database.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "prisma db seed",
    "test:database": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/database.integration.test.ts tests/leave.integration.test.ts",
    "db:seed:accounts": "tsx --env-file=.env prisma/seed-accounts.ts",
    "auth:check:demo": "tsx --env-file=.env src/scripts/check-demo-auth.ts",
    "demo:promote:admins": "tsx --env-file=.env src/scripts/promote-demo-admins.ts",
    "leave:check:demo": "tsx --env-file=.env src/scripts/check-demo-leave.ts",
    "manager:check:demo": "tsx --env-file=.env src/scripts/check-demo-manager.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
