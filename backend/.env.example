NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required locally; never paste credentials into chat or Git.
DATABASE_URL=
# Optional separate direct/session connection for migrations; defaults to DATABASE_URL.
# DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use the legacy public anon key.
# SUPABASE_ANON_KEY=
# Optional for normal startup; server-only and required by the demo Auth seed.
SUPABASE_SERVICE_ROLE_KEY=
