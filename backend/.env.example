NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required locally; never paste credentials into chat or Git.
DATABASE_URL=
# Optional separate direct/session connection for migrations; defaults to DATABASE_URL.
# DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use the legacy public anon key.
# SUPABASE_ANON_KEY=
# Optional for normal startup; server-only and required by the demo Auth seed.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar only (not Google sign-in). Leave CLIENT_ID blank to keep it disabled.
# Run npm run calendar:configure to prepare ignored local keys without printing them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://the-leave-tracker-skfc.vercel.app/api/v1/integrations/google/callback
GOOGLE_FRONTEND_RETURN_URL=https://the-leave-tracker-skfc.vercel.app/admin
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_KEY_VERSION=1
GOOGLE_INVITATION_LIMIT=100
# Same value as GitHub Actions secret CALENDAR_CRON_SECRET; never use a VITE_ prefix.
CRON_SECRET=
# During key rotation, JSON map of earlier versions to their base64 keys (server-only).
# GOOGLE_TOKEN_PREVIOUS_KEYS=

# Optional Gemini drafting, manager assistant and data questions; server only.
# Ordinary leave workflows work without a key.
# Create a key in a Google AI Studio free-tier project; never use VITE_ for this key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AI_TIMEOUT_MS=12000
